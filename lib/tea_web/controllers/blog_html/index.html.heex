<Layouts.app flash={@flash} current_scope={@current_scope}>
  <main class="site-main site-main--narrow">
    <header class="page-heading">
      <p class="kicker">{@section_label}</p>
      <h1>{@section_title}</h1>
      <p>
        {@section_description}
      </p>
    </header>

    <section class="article-list">
      <div :if={@articles == []} class="empty-entry">
        <p class="kicker">{@empty_title}</p>
        <p>{@empty_description}</p>
      </div>

      <article :for={article <- @articles} class="article-row">
        <div class="article-row__meta">
          <time datetime={Date.to_iso8601(article.date)}>
            {Calendar.strftime(article.date, "%b %d, %Y")}
          </time>
        </div>

        <div class="article-row__body">
          <h2>
            <a href={"#{@section_path}/#{article.slug}"}>{article.title}</a>
          </h2>
          <p>{article.excerpt}</p>

          <div class="tag-list" aria-label="Article tags">
            <span :for={tag <- article.tags}>{tag}</span>
          </div>
        </div>
      </article>
    </section>

    <div class="lower-nav">
      <a href={~p"/"} class="text-link">Back home</a>
    </div>
  </main>
</Layouts.app>
