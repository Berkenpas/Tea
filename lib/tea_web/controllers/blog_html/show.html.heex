<Layouts.app flash={@flash} current_scope={@current_scope}>
  <main class="site-main site-main--article">
    <nav class="article-back" aria-label="Article navigation">
      <a href={@section_path} class="text-link">Back to {String.downcase(@section_label)}</a>
    </nav>

    <article class="article-shell">
      <header class="article-header">
        <p class="kicker">
          <time datetime={Date.to_iso8601(@article.date)}>
            {Calendar.strftime(@article.date, "%B %d, %Y")}
          </time>
        </p>
        <h1>{@article.title}</h1>

        <div class="article-meta">
          <span
            :if={@article.rating}
            class={["rating-chip", rating_tone(@article.rating)]}
            aria-label={"Tea rating: #{format_rating(@article.rating)} out of 10"}
          >
            <span class="rating-chip__label">Rating</span>
            <strong>{format_rating(@article.rating)}/10</strong>
          </span>

          <div :if={@article.tags != []} class="tag-list" aria-label="Article tags">
            <span :for={tag <- @article.tags}>{tag}</span>
          </div>
        </div>
      </header>

      <div class="article-body">
        {Phoenix.HTML.raw(@article.html)}
      </div>
    </article>
  </main>
</Layouts.app>
