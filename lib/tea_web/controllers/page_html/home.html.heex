<Layouts.app flash={@flash} current_scope={@current_scope}>
  <main class="site-main">
    <section class="home-hero">
      <div class="home-hero__copy">
        <p class="kicker">Unrelated notes from the Pacific Northwest</p>

        <h1 class="display-title" aria-label="Berkenpas.">
          <span class="typing-word typing-word--berkenpas" aria-hidden="true">Berkenpas.</span>
          <span class="typing-word typing-word--blog" aria-hidden="true">Blog.</span>
        </h1>

        <p class="lede">
          Quiet ideas brewed slowly
        </p>

        <div class="action-row">
          <a href={~p"/writings"} class="text-link text-link--strong">Read writings</a>
          <a :if={@recent_article} href={@recent_article_path} class="text-link">
            Recent post
          </a>
          <a href={~p"/guestbook"} class="text-link home-community-link">
            <span>Guest Book</span>
            <span
              :if={@guestbook_entry_count > 0}
              class="count-badge"
              aria-label="guestbook entries"
            >
              {@guestbook_entry_count}
            </span>
          </a>
        </div>
      </div>

      <div class="home-hero__logo">
        <img src={~p"/images/BerkenpasLogo.svg"} alt="Berkenpas logo" />
      </div>
    </section>

    <div class="home-after-space" aria-hidden="true"></div>
  </main>
</Layouts.app>
